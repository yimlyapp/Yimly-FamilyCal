# Yimly FamilyCal Environment Configuration

# Server Port and Environment
PORT=3000
NODE_ENV="production"

# Database storage path (defaults to ./data/yimly_familycal.db in dev, /data/yimly_familycal.db in Docker)
DATA_DIR="./data"

# Application Session & JWT Secret Key
SESSION_SECRET="change-this-to-a-secure-random-secret-key"

# Public App URL (e.g., https://familycal.robinhort.link or http://localhost:3000)
APP_URL="https://familycal.robinhort.link"

# Optional Google Calendar OAuth 2.0 Integration
# Obtain credentials from Google Cloud Console -> APIs & Services -> Credentials
# Redirect URI configured in Google Console should match: https://<YOUR-DOMAIN>/api/v1/calendar/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://familycal.robinhort.link/api/v1/calendar/google/callback"

# Optional Gemini API Key
GEMINI_API_KEY=""
