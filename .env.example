NODE_ENV=production
PORT=3000
DATA_DIR=/data

# Required: replace with a long random secret before running in production.
SESSION_SECRET=replace_with_a_secure_random_session_secret_key

# Public FamilyCal URL
APP_URL=https://familycal.robinhort.link

# Optional Google Calendar OAuth 2.0 Integration
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://familycal.robinhort.link/api/v1/calendar/google/callback
